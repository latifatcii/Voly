<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forms_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/forms_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/forms_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="name"
            android:hint="@string/forms_name_hint"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/forms_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="password"
            android:hint="@string/forms_password_hint"
            android:inputType="textPassword" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/forms_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp"
            android:text="@string/forms_switch" />

        <CheckBox
            android:id="@+id/forms_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forms_checkbox" />

        <TextView
            android:id="@+id/forms_seekbar_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/forms_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:minHeight="48dp"
            android:progress="40" />

        <!-- Mirrors the seek bar. -->
        <ProgressBar
            android:id="@+id/forms_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="40" />

        <RadioGroup
            android:id="@+id/forms_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checkedButton="@id/forms_radio_medium"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/forms_radio_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forms_radio_small" />

            <RadioButton
                android:id="@+id/forms_radio_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forms_radio_medium" />

            <RadioButton
                android:id="@+id/forms_radio_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forms_radio_large" />
        </RadioGroup>

        <Spinner
            android:id="@+id/forms_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/forms_spinner_entries"
            android:minHeight="48dp" />

        <LinearLayout
            android:id="@+id/forms_button_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forms_submit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forms_submit"
                app:icon="@drawable/ic_star" />

            <Button
                android:id="@+id/forms_disabled_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:enabled="false"
                android:text="@string/forms_disabled" />

            <ImageView
                android:id="@+id/forms_star_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/forms_star_description"
                android:src="@drawable/ic_star"
                app:tint="@color/swatch_amber" />
        </LinearLayout>

        <TextView
            android:id="@+id/forms_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/forms_status_idle" />
    </LinearLayout>
</ScrollView>
