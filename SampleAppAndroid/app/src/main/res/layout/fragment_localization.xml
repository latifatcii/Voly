<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loc_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/loc_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/loc_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loc_heading"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <!-- Formatted in code: loc_greeting with an argument. -->
        <TextView
            android:id="@+id/loc_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/loc_current_locale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Plural: loc_items_count for 3. -->
        <TextView
            android:id="@+id/loc_items_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/loc_long_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/loc_long_text"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <Button
            android:id="@+id/loc_details_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/loc_show_details" />

        <TextView
            android:id="@+id/loc_language_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loc_language_label"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <!-- Switches the per-app language (AppCompatDelegate.setApplicationLocales). -->
        <HorizontalScrollView
            android:id="@+id/loc_language_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/loc_language_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/loc_lang_system"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loc_language_system" />

                <Button
                    android:id="@+id/loc_lang_en"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loc_lang_en" />

                <Button
                    android:id="@+id/loc_lang_tr"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loc_lang_tr" />

                <Button
                    android:id="@+id/loc_lang_fr"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loc_lang_fr" />

                <Button
                    android:id="@+id/loc_lang_ar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loc_lang_ar" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
